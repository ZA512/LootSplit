# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
LOOTSPLIT_ADMIN_TOKEN=
PORT=8000
BIND_ADDRESS=127.0.0.1
APPDATA_PATH=./data
PUID=1000
PGID=1000
# true lorsque l'application est accessible en HTTPS (reverse proxy).
LOOTSPLIT_SECURE_COOKIE=false
# Connexion Crédit Agricole facultative. Laisser vide pour fonctionner par CSV.
# Exemple de caisse : www.ca-paris.fr (adapter à votre caisse régionale).
LOOTSPLIT_BANK_WEBSITE=
LOOTSPLIT_BANK_LOGIN=
LOOTSPLIT_BANK_PASSWORD=
# Sauvegardes quotidiennes : 7 copies quotidiennes + 4 hebdomadaires.
LOOTSPLIT_BACKUP_ENABLED=true
LOOTSPLIT_BACKUP_TIME=03:00
LOOTSPLIT_BACKUP_TIMEZONE=Europe/Paris
